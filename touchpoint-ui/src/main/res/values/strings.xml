<?xml version="1.0" encoding="utf-8"?>
<!-- The chat UI's string resources. Every user-facing string the chat UI renders or speaks is
     declared here, so localisation is a resource edit, never a code change. Every name carries the
     touchpoint_ prefix: library resources merge into the host's namespace, and a host resource of
     the same name wins. Wording follows Touchpoint web 1.0.4; values-*/ hold web's own translations,
     generated by Scripts/web-copy.py. -->
<resources>
    <!-- Composer -->
    <string name="touchpoint_composer_placeholder">Type something</string>
    <string name="touchpoint_composer_send">Send message</string>
    <string name="touchpoint_composer_send_failed">Message not sent. It stays in the box so you can try again.</string>

    <!-- Header and menu -->
    <string name="touchpoint_header_title">AI Assistant</string>
    <string name="touchpoint_header_restart">Restart conversation</string>
    <string name="touchpoint_header_settings">Settings</string>
    <string name="touchpoint_header_collapse">Collapse</string>
    <string name="touchpoint_header_close">Close</string>
    <string name="touchpoint_header_settings_close">Close settings</string>
    <string name="touchpoint_voice_minimise">Minimise</string>
    <string name="touchpoint_voice_minimise_action">Keeps the call going</string>
    <string name="touchpoint_menu_restart">Restart conversation</string>
    <string name="touchpoint_menu_download">Download transcript</string>
    <string name="touchpoint_menu_end">End conversation</string>
    <!-- The confirmation before ending, worded as Touchpoint web's. -->
    <string name="touchpoint_confirm_end_title">Are you sure?</string>
    <string name="touchpoint_confirm_end_body">You are about to end the current conversation. This action can\'t be undone.</string>
    <string name="touchpoint_confirm_cancel">Cancel</string>
    <string name="touchpoint_confirm_end">End conversation</string>
    <!-- Shown in the transcript when the conversation is over, and offered in place of the composer. -->
    <string name="touchpoint_notice_ended">Conversation has ended</string>
    <string name="touchpoint_action_start_new">Start new conversation</string>
    <!-- Spoken when the session refuses a restart or an end; web has no such message, the control simply does nothing. -->
    <string name="touchpoint_restart_failed">The conversation could not be restarted. Please try again.</string>
    <string name="touchpoint_end_failed">The conversation could not be ended. Please try again.</string>
    <!-- The share sheet's title and subject for Download transcript; web saves chat-transcript.txt. -->
    <string name="touchpoint_transcript_share_title">Chat transcript</string>
    <!-- Who said it, in the shared transcript: the customer, the assistant, a person. -->
    <string name="touchpoint_transcript_name_you">You</string>
    <string name="touchpoint_transcript_name_ai">AI</string>
    <string name="touchpoint_transcript_name_agent">Agent</string>

    <!-- A quick-reply choice that came with no title, numbered as web numbers it. -->
    <string name="touchpoint_choice_untitled">Option %1$d</string>
    <!-- The choices' group, as web labels it for a screen reader. -->
    <string name="touchpoint_choices_label">Response options</string>
    <!-- Spoken when a choice could not be sent; the choices come back to choose again. -->
    <string name="touchpoint_choice_failed">Your choice was not sent. Please try again.</string>

    <!-- Transcript -->
    <string name="touchpoint_transcript_label">Conversation</string>
    <!-- TalkBack label for one message: the sender, then the text. -->
    <string name="touchpoint_transcript_bubble_label">%1$s: %2$s</string>
    <string name="touchpoint_transcript_load_earlier">Load earlier messages</string>
    <string name="touchpoint_transcript_load_failed">Earlier messages could not be loaded.</string>
    <string name="touchpoint_action_retry">Try again</string>
    <!-- Copy a message, by TalkBack's actions or a long press: a mobile need, as native text is not selectable as a web page's is. -->
    <string name="touchpoint_action_copy">Copy</string>
    <!-- Spoken after a copy where the system does not say so itself (Android 12). -->
    <string name="touchpoint_copied">Copied</string>
    <!-- TalkBack's action for a link in a message: the link's own words. -->
    <string name="touchpoint_action_open_link">Open link: %1$s</string>
    <!-- The inline error row, worded as Touchpoint web's for a dropped connection. -->
    <string name="touchpoint_problem_banner">Connection lost. Please try again.</string>
    <string name="touchpoint_problem_dismiss">Dismiss</string>

    <!-- Senders -->
    <string name="touchpoint_sender_you">You</string>
    <string name="touchpoint_sender_support">Support</string>
    <string name="touchpoint_sender_supervisor">Supervisor</string>
    <!-- TalkBack reads an arriving message's own text, as web does; this is for one with no text (an attachment, say). -->
    <string name="touchpoint_announcement_received">Response received</string>
    <!-- After a message's text, how many options it offers, as web's announcer says. -->
    <plurals name="touchpoint_announcement_choices">
        <item quantity="one">%d option to choose from</item>
        <item quantity="other">%d options to choose from</item>
    </plurals>

    <!-- Delivery state of the customer's own messages -->
    <string name="touchpoint_delivery_sending">Sending</string>
    <string name="touchpoint_delivery_sent">Sent</string>
    <string name="touchpoint_delivery_delivered">Delivered</string>
    <string name="touchpoint_delivery_read">Read</string>
    <string name="touchpoint_delivery_failed">Failed</string>

    <!-- Connection status -->
    <string name="touchpoint_status_connecting">Connecting...</string>
    <!-- Web's interim line after the customer sends, until the reply comes. -->
    <string name="touchpoint_status_thinking">Thinking...</string>
    <!-- Web's interim line while an agent types. -->
    <string name="touchpoint_status_typing">Typing...</string>
    <!-- Web's notices when a person joins or leaves the conversation. -->
    <string name="touchpoint_notice_agent_joined">Agent has joined</string>
    <string name="touchpoint_notice_agent_left">Agent has left</string>
    <string name="touchpoint_status_ended">This conversation has ended</string>
    <!-- Attachments: web's own words, which it leaves in English in every language. -->
    <string name="touchpoint_attach_upload">Upload file</string>
    <string name="touchpoint_attach_delete">Delete</string>
    <string name="touchpoint_attach_too_big">The file is too big. Max file size: 8mb</string>
    <string name="touchpoint_attach_failed">The file could not be uploaded.</string>
    <string name="touchpoint_attach_unreadable">Something went wrong. Please try again.</string>
    <string name="touchpoint_attach_download">Download</string>
    <!-- The chat's mini bar: web's launcher label ("Expand chat"), and its close. Left in English, as web leaves them. -->
    <string name="touchpoint_mini_expand">Expand chat</string>
    <string name="touchpoint_mini_close">Close</string>
    <!-- Web's modalities. The date input's and video's are web's own words, which it leaves in English. -->
    <string name="touchpoint_modality_date">Date</string>
    <string name="touchpoint_modality_date_placeholder">MM / DD / YYYY</string>
    <string name="touchpoint_modality_open_date_picker">Open date picker</string>
    <!-- The date input's own Send, named apart from the composer's for TalkBack (Android's words). -->
    <string name="touchpoint_modality_date_send">Send date</string>
    <string name="touchpoint_modality_play_video">Play video</string>
    <!-- A card picked from a carousel, for TalkBack. -->
    <string name="touchpoint_modality_selected">Selected</string>
    <!-- Web's guide card (a Connect View), translated by web. -->
    <string name="touchpoint_guide_label">Guide</string>
    <string name="touchpoint_guide_default_title">Guide</string>
    <string name="touchpoint_guide_not_started">Not started</string>
    <string name="touchpoint_guide_in_progress">In progress</string>
    <string name="touchpoint_guide_complete">Complete</string>
    <string name="touchpoint_guide_loading">Loading guide…</string>
    <string name="touchpoint_guide_error">Couldn\'t load the guide</string>
    <string name="touchpoint_guide_close">Close</string>
    <!-- Connect's sign-in card (Authenticate Customer): web's authentication copy. -->
    <string name="touchpoint_authentication_heading">Please authenticate</string>
    <string name="touchpoint_authentication_authenticate">Authenticate</string>
    <string name="touchpoint_authentication_skip">Continue without signing in</string>
    <string name="touchpoint_authentication_locked_hint">Complete or skip authentication before continuing.</string>
    <string name="touchpoint_authentication_in_progress">Authentication in progress</string>
    <string name="touchpoint_authentication_success">Authentication successful</string>
    <string name="touchpoint_authentication_failed">Authentication failed</string>
    <string name="touchpoint_authentication_expired">Authentication expired</string>
    <string name="touchpoint_authentication_cancelled">Authentication cancelled</string>
    <!-- Live Sync's consent, and a permission that is off (web has neither). -->
    <string name="touchpoint_consent_title">Share what you\'re doing in the app?</string>
    <!-- %1$s: what is shared; %2$s: who receives it. Both from the host's ConsentPrompt. -->
    <string name="touchpoint_consent_body">While you talk with us, the app can share %1$s with %2$s so the assistant can help you on screen. Nothing is shared until you agree, and you can stop at any time.</string>
    <string name="touchpoint_consent_allow">Allow</string>
    <!-- A Live Sync action the app marks for confirmation: the assistant asked, the customer decides. -->
    <string name="touchpoint_action_confirm_title">Allow the assistant to do this?</string>
    <string name="touchpoint_consent_decline">Not now</string>
    <string name="touchpoint_consent_privacy_policy">Privacy policy</string>
    <string name="touchpoint_consent_revoke">Stop sharing</string>
    <string name="touchpoint_consent_revoked">Sharing stopped. The assistant can no longer see the app.</string>
    <string name="touchpoint_permission_microphone_title">Microphone is off</string>
    <string name="touchpoint_permission_microphone_body">Calling needs the microphone. You can keep chatting with us here, or turn the microphone on in Settings.</string>
    <string name="touchpoint_permission_open_settings">Open Settings</string>
    <string name="touchpoint_permission_continue_with_chat">Continue with chat</string>
    <!-- Voice: web's own words, which it leaves in English in every language. -->
    <string name="touchpoint_voice_speakers">Speakers</string>
    <string name="touchpoint_voice_microphone">Voice</string>
    <string name="touchpoint_voice_error_title">Oops!</string>
    <string name="touchpoint_voice_error_body">Something went wrong.</string>
    <string name="touchpoint_voice_error_hint">Try again later.</string>
    <string name="touchpoint_voice_retry">Retry</string>
    <!-- TalkBack: the state of Voice (the microphone) and Speakers, which web's controls leave unsaid. -->
    <string name="touchpoint_voice_on">On</string>
    <string name="touchpoint_voice_off">Off</string>
    <!-- Web's mini voice widget: its own words, which it leaves in English. -->
    <string name="touchpoint_voice_mini_microphone">Microphone</string>
    <string name="touchpoint_voice_mini_error">I couldn’t connect</string>
    <string name="touchpoint_voice_mini_ended">The conversation has ended.</string>
    <!-- A call's states, spoken by TalkBack and shown under the orb (web announces none). -->
    <string name="touchpoint_call_connecting">Calling…</string>
    <string name="touchpoint_call_connected">Call connected</string>
    <string name="touchpoint_call_reconnecting">Reconnecting the call…</string>
    <string name="touchpoint_call_interrupted">Call on hold for another call</string>
    <string name="touchpoint_call_resumed">Call resumed</string>
    <string name="touchpoint_call_ended">Call ended</string>
    <!-- TalkBack's "double-tap to …" for the red Collapse, which hangs the call up first, as web's does. -->
    <string name="touchpoint_call_end_action">end the call</string>
    <!-- The header's Settings while the settings are showing, for TalkBack (Android's words). -->
    <!-- A call's rail (Open chat and More options; web's rail has neither). -->
    <string name="touchpoint_call_open_chat">Open chat</string>
    <string name="touchpoint_call_menu">More options</string>
    <string name="touchpoint_call_failed">Call failed</string>
    <string name="touchpoint_call_muted">Microphone muted</string>
    <string name="touchpoint_call_unmuted">Microphone on</string>
    <!-- %1$s: where the call is heard: "Speaker", "Phone", a headset's own name. -->
    <string name="touchpoint_call_route">Audio on %1$s</string>
    <!-- Screen sharing, customer to agent (web has none). -->
    <string name="touchpoint_call_share_screen">Share screen</string>
    <string name="touchpoint_call_stop_sharing">Stop sharing screen</string>
    <string name="touchpoint_call_share_available">Screen sharing available</string>
    <string name="touchpoint_call_share_started">Sharing your screen</string>
    <string name="touchpoint_call_share_stopped">Screen sharing stopped</string>
    <!-- Asked before the first frame leaves: Android shows no prompt of its own for an app's own screen. -->
    <string name="touchpoint_call_share_title">Share your screen?</string>
    <string name="touchpoint_call_share_body">The agent will see this app\'s screen until you stop or the call ends. Other apps and your notifications are not shared.</string>
    <string name="touchpoint_call_share_confirm">Share</string>
    <string name="touchpoint_call_share_cancel">Not now</string>
    <!-- Where the call is heard, a mobile need web has no control for. -->
    <string name="touchpoint_call_output">Audio output</string>
    <string name="touchpoint_call_output_speaker">Speaker</string>
    <string name="touchpoint_call_output_earpiece">Phone</string>
    <string name="touchpoint_call_output_wired">Headphones</string>
    <string name="touchpoint_call_output_usb">USB headset</string>
    <string name="touchpoint_call_output_bluetooth">Bluetooth</string>
    <string name="touchpoint_voice_ended_title">The conversation has ended</string>
    <string name="touchpoint_voice_ended_body">You can close this panel now or restart.</string>
</resources>
